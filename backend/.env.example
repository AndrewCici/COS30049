# Copy to backend/.env and adjust, or pass directly to uvicorn:
#   uvicorn app.main:app --env-file .env

# Origin the API accepts cross-origin requests from (CORS). Must match
# where the frontend dev server actually runs.
FRONTEND_ORIGIN=http://localhost:5173

# Force one detection method instead of the default fallback chain.
# One of: hf-transformer | statistical | mock
#AIDETECT_METHOD=statistical

# 1 adds the mock detector to the end of the fallback chain (tests only).
#AIDETECT_ALLOW_MOCK=0

# 1 opts into the pretrained RoBERTa transformer as the primary detector.
# Needs requirements-optional.txt installed and downloads ~500MB of
# weights on first use.
AIDETECT_ENABLE_HF=0

# Override the HuggingFace model id used when AIDETECT_ENABLE_HF=1.
#AIDETECT_HF_MODEL=Hello-SimpleAI/chatgpt-detector-roberta

# Input limits enforced on every /score request.
AIDETECT_MIN_TEXT_CHARS=20
AIDETECT_MAX_TEXT_CHARS=12000
AIDETECT_MAX_SENTENCES=300
